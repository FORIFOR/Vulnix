# Vulnix 設定例（秘密の値は入っていません）
# 使うものだけを .env.local にコピーしてください。.env.local は Git の管理外で、パーミッションは 600 にします。
# テストでは VULNIX_NO_ENV_LOCAL=1 を付け、.env.local を読み込まないようにします。

# ---- 動作モード -------------------------------------------------------------
# development にすると、開発用の緩和（読み取り API の認証の省略など）を明示的に選べます。本番では設定しません。
# AEGIS_ENV=development
# 組織（テナント）分離。既定で有効。0 にすると、従来の単一ワークスペースで動きます。
# VULNIX_MULTI_TENANT=1
# 一般の人が自分でアカウントを作れるようにします（作った人には、その人だけの組織が作られます）。
# VULNIX_PUBLIC_SIGNUP=0
# L2 の依頼者と承認者を必ず別の人にします。
# AEGIS_SEPARATE_L2_APPROVER=1

# ---- AI（Abliteration AI / OpenAI 互換） ------------------------------------
# AI 解説に使います。設定しなければ、内蔵の解説だけで動きます。
# VULNIX_ABLITERATION_URL=https://api.abliteration.ai/v1/chat/completions
# VULNIX_ABLITERATION_MODEL=abliterated-model
# VULNIX_ABLITERATION_KEY=            # ← 秘密。ここに書かず .env.local にだけ書きます
# AI の提案を診断計画に使うかどうか（0 = 使わない。AI は解説だけに使う）
# VULNIX_EXTERNAL_PROPOSALS=0

# ---- ARTEX（Linux のみ） ----------------------------------------------------
# VULNIX_ARTEX_REAL_CMD=/opt/artex-bin/artex-vulnix-planner
# VULNIX_ARTEX_EXPECTED_SHA256=        # 本番では必須（ARTEX バイナリのハッシュを固定）
# VULNIX_ARTEX_PG_DSN=postgres://artex_planner:<password>@127.0.0.1:5432/artex_planner?sslmode=disable
# ARTEX のモデル通信: direct / gateway-preview / gateway-forward（gateway-forward はプレビューの承認が必要）
# VULNIX_ARTEX_LLM_MODE=gateway-preview
# VULNIX_ARTEX_LLM_MODEL=abliterated-model
# 1回の計画で使えるモデル呼び出しの上限
# VULNIX_PLANNER_LLM_MAX_CALLS=6
# VULNIX_PLANNER_LLM_MAX_TOKENS=60000
# VULNIX_PLANNER_LLM_MAX_COST_USD=0.50
# VULNIX_PLANNER_LLM_USD_PER_1K_INPUT=0.001
# VULNIX_PLANNER_LLM_USD_PER_1K_OUTPUT=0.003

# ---- Web UI（web/） -----------------------------------------------------------
# コントロールプレーンの場所（ループバックだけ）
# AEGIS_API=http://127.0.0.1:8787
# 公開β版のインスタンスだけで 1 にします（紹介ページ以外を返しません）
# VULNIX_PUBLIC_MODE=0
