[Unit]
Description=Vulnix control plane (loopback only)
After=network-online.target nftables.service vulnix-anchor.service
# every critical audit record is checked against the anchor first (docs/AUDIT_ANCHOR.md)
Requires=vulnix-anchor.service
Wants=network-online.target

[Service]
User=vulnix
Group=vulnix
# connect access to the anchor's socket only (its directory is 0750 vulnix-anchor)
SupplementaryGroups=vulnix-anchor
UMask=0077
WorkingDirectory=/opt/vulnix/backend
Environment=PATH=/usr/sbin:/usr/bin
Environment=PYTHONPATH=/opt/vulnix/backend/vendor:/opt/vulnix/backend
Environment=VULNIX_NO_ENV_LOCAL=1
# the only root program it may run (sudoers): aegis/privbroker.py through this wrapper
Environment=VULNIX_PRIV_BROKER=/usr/local/libexec/vulnix-priv
# VULNIX_AUDIT_ANCHOR_SOCKET / _UID / _SOURCE (written by provision.sh; never from .env.local)
EnvironmentFile=/etc/vulnix/anchor.env
Environment=VULNIX_PUBLIC_SIGNUP=1
# 0 = no traffic to real sites at all (until DeepNote's L1 acceptance is approved; then l1)
Environment=VULNIX_REAL_SERVICE_DIAGNOSIS=0
Environment=VULNIX_REAL_SITE_LOCAL_ARTEX=0
Environment=VULNIX_ARTEX_LLM_PLANS_PER_HOUR=0
Environment=VULNIX_CHAT_PER_DAY=0
ExecStart=/usr/bin/python3 -m aegis.server --port 8788 --data-dir /var/lib/vulnix
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
# sized from measurement: one descriptor per loaded organization (at most 500 by default)
# plus connections and worker pipes (tests/test_data_dir_lock_cleanup.py)
LimitNOFILE=8192
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/var/lib/vulnix
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
