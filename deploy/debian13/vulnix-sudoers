# The control plane (user vulnix) starts confined workers: network namespaces (ip),
# per-run egress tables (nft), the cgroup join and namespace entry (sh -c with a fixed
# script in aegis/confinement.py) and the drop to the worker's uid (setpriv).
# Because sh is allowed, this is root-equivalent for the vulnix account; it is listed
# as a residual risk (docs/PRODUCT_VISION_TRACEABILITY.md). The web server account
# (vulnix-web) has no sudo at all.
Defaults:vulnix !requiretty, !lecture, logfile=/var/log/sudo-vulnix.log
vulnix ALL=(root) NOPASSWD:SETENV: /usr/bin/sh, /usr/sbin/nft, /usr/sbin/ip, /usr/bin/setpriv
